- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, echantillons_sec=128):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Mapping Phase QPSK',\n            in_sig=[np.int32],\
      \      \n            out_sig=[np.complex64]\n        )\n        self.symbols\
      \ = [1+1j, -1+1j, 1-1j, -1-1j] \n\n    def work(self, input_items, output_items):\n\
      \        in0 = input_items[0]  \n        out = output_items[0]         \n  \
      \      for i in range(len(in0)):\n            out[i] = in0[i]\n            \n\
      \        return len(out)"
    affinity: ''
    alias: ''
    comment: ''
    echantillons_sec: Rs
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Mapping Phase QPSK', 'blk', [('echantillons_sec', '128')], [('0',
      'int', 1)], [('0', 'complex', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 344.0]
    rotation: 0
    state: enabled
