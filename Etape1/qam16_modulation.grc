- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block - 16-QAM Modulator\nConvertit des\
      \ symboles (0 \xE0 15) en symboles 16-QAM\n\"\"\"\n\nimport numpy as np\nfrom\
      \ gnuradio import gr\n\nclass blk(gr.sync_block):\n    \"\"\"Bloc de modulation\
      \ 16-QAM\"\"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='16-QAM Modulator',\n            in_sig=[np.uint8],\n\
      \            out_sig=[np.complex64]\n        )\n\n    def work(self, input_items,\
      \ output_items):\n        \"\"\"Convertit les symboles en 16-QAM\"\"\"\n   \
      \     symbols = input_items[0]\n        out = output_items[0]\n        \n  \
      \      # Niveaux d'amplitude pour 16-QAM\n        # -3, -1, +1, +3\n       \
      \ # Normalis\xE9s pour avoir une puissance moyenne = 1\n        levels = [-3.0,\
      \ -1.0, 1.0, 3.0]\n        \n        # Table de mapping 16-QAM (grille 4x4)\n\
      \        # Chaque symbole (0-15) correspond \xE0 une combinaison (I, Q)\n  \
      \      constellation = []\n        for i in range(4):      # Pour chaque niveau\
      \ I\n            for q in range(4):  # Pour chaque niveau Q\n              \
      \  constellation.append(complex(levels[i], levels[q]))\n        \n        #\
      \ Normalisation (puissance moyenne = 1)\n        constellation = np.array(constellation)\
      \ / np.sqrt(10.0)\n        \n        for i in range(len(symbols)):\n       \
      \     sym = symbols[i] % 16\n            out[i] = constellation[sym]\n     \
      \   \n        return len(symbols)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('16-QAM Modulator', 'blk', [], [('0', 'byte', 1)], [('0', 'complex',
      1)], 'Bloc de modulation 16-QAM', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [672, 216.0]
    rotation: 0
    state: enabled
