- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Bloc de modulation BPSK\"\"\"\n\n    def __init__(self):\n      \
      \  gr.sync_block.__init__(\n            self,\n            name='BPSK Modulator',\n\
      \            in_sig=[np.uint8],\n            out_sig=[np.complex64]\n      \
      \  )\n\n    def work(self, input_items, output_items):\n        \"\"\"Convertit\
      \ les bits en symboles BPSK\"\"\"\n        bits = input_items[0]\n        out\
      \ = output_items[0]\n        \n        # BPSK : bit 0 -> +1, bit 1 -> -1\n \
      \       for i in range(len(bits)):\n            if bits[i] == 0:\n         \
      \       out[i] = complex(1.0, 0.0)\n            else:\n                out[i]\
      \ = complex(-1.0, 0.0)\n        \n        return len(bits)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('BPSK Modulator', 'blk', [], [('0', 'byte', 1)], [('0', 'complex',
      1)], 'Bloc de modulation BPSK', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 272.0]
    rotation: 0
    state: enabled
- name: qtgui_const_sink_x_0
  id: qtgui_const_sink_x
