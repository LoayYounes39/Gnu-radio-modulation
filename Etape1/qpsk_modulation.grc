- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block - QPSK Modulator\nConvertit des symboles\
      \ (0, 1, 2, 3) en symboles QPSK\n\"\"\"\n\nimport numpy as np\nfrom gnuradio\
      \ import gr\n\nclass blk(gr.sync_block):\n    \"\"\"Bloc de modulation QPSK\"\
      \"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(\n         \
      \   self,\n            name='QPSK Modulator',\n            in_sig=[np.uint8],\n\
      \            out_sig=[np.complex64]\n        )\n\n    def work(self, input_items,\
      \ output_items):\n        \"\"\"Convertit les symboles en QPSK\"\"\"\n     \
      \   symbols = input_items[0]\n        out = output_items[0]\n        \n    \
      \    # Table de mapping QPSK :\n        # 0 -> +1+1j\n        # 1 -> -1+1j\n\
      \        # 2 -> -1-1j\n        # 3 -> +1-1j\n        constellation = [\n   \
      \         complex(1.0, 1.0),   # 0\n            complex(-1.0, 1.0),  # 1\n \
      \           complex(-1.0, -1.0), # 2\n            complex(1.0, -1.0)   # 3\n\
      \        ]\n        \n        for i in range(len(symbols)):\n            sym\
      \ = symbols[i] % 4\n            out[i] = constellation[sym]\n        \n    \
      \    return len(symbols)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('QPSK Modulator', 'blk', [], [('0', 'byte', 1)], [('0', 'complex',
      1)], 'Bloc de modulation QPSK', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 208.0]
    rotation: 0
    state: enabled
- name: qtgui_const_sink_x_1
  id: qtgui_const_sink_x
  parameters:
