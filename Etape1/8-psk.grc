- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block - 8-PSK Modulator\nConvertit des\
      \ symboles (0 \xE0 7) en symboles 8-PSK\n\"\"\"\n\nimport numpy as np\nfrom\
      \ gnuradio import gr\n\nclass blk(gr.sync_block):\n    \"\"\"Bloc de modulation\
      \ 8-PSK\"\"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='8-PSK Modulator',\n            in_sig=[np.uint8],\n\
      \            out_sig=[np.complex64]\n        )\n\n    def work(self, input_items,\
      \ output_items):\n        \"\"\"Convertit les symboles en 8-PSK\"\"\"\n    \
      \    symbols = input_items[0]\n        out = output_items[0]\n        \n   \
      \     # 8-PSK : 8 points sur un cercle \xE0 45\xB0 d'\xE9cart\n        constellation\
      \ = [\n            complex(1.0, 0.0),           # 0 : 0\xB0\n            complex(0.707,\
      \ 0.707),       # 1 : 45\xB0\n            complex(0.0, 1.0),           # 2 :\
      \ 90\xB0\n            complex(-0.707, 0.707),      # 3 : 135\xB0\n         \
      \   complex(-1.0, 0.0),          # 4 : 180\xB0\n            complex(-0.707,\
      \ -0.707),     # 5 : 225\xB0\n            complex(0.0, -1.0),          # 6 :\
      \ 270\xB0\n            complex(0.707, -0.707)       # 7 : 315\xB0\n        ]\n\
      \        \n        for i in range(len(symbols)):\n            sym = symbols[i]\
      \ % 8\n            out[i] = constellation[sym]\n        \n        return len(symbols)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('8-PSK Modulator', 'blk', [], [('0', 'byte', 1)], [('0', 'complex',
      1)], 'Bloc de modulation 8-PSK', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 208.0]
    rotation: 0
    state: enabled
