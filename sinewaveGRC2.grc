- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, echantillons_sec=128):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Mapping Phase BPSK',\n            in_sig=None,\n\
      \            out_sig=[np.complex64]\n        )\n        self.symbols = [-1,\
      \ +1]\n\n    def work(self, input_items, output_items):\n        out = output_items[0]\n\
      \        n = len(out)\n        index = 0\n        for i in range(n):\n     \
      \       out[i] = self.symbols[index]\n            index = (index + 1) % len(self.symbols)\n\
      \        return len(out)"
    affinity: ''
    alias: ''
    comment: ''
    echantillons_sec: Rs
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Mapping Phase BPSK', 'blk', [('echantillons_sec', '128')], [], [('0',
      'complex', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [152, 352.0]
    rotation: 0
    state: enabled
