- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Mapping 16QAM',\n            in_sig=[np.uint8],\n       \
      \     out_sig=[np.complex64],\n        )\n        niveaux = [-3, -1, 1, 3]\n\
      \        # Table de 16 symboles complexes : I + jQ\n        self.symboles =\
      \ np.array(\n            [complex(i, q) for i in niveaux for q in niveaux],\n\
      \            dtype=np.complex64\n        )\n\n    def work(self, input_items,\
      \ output_items):\n        entiers = input_items[0]\n        sortie = output_items[0]\n\
      \n        # Mapping vectoris\xE9 : chaque entier (0 \xE0 15) indexe la table\n\
      \        sortie[:] = self.symboles[entiers]\n\n        return len(sortie)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Mapping 16QAM', 'blk', [], [('0', 'byte', 1)], [('0', 'complex',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 1088.0]
    rotation: 0
    state: enabled
- name: epy_block_1_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='16 QAM symbole plus proche',\n            in_sig=[np.complex64],\n\
      \            out_sig=[np.complex64],\n        )\n        niveaux = [-3, -1,\
      \ 1, 3]   # m\xEAme liste que le mapping\n        self.symboles = np.array(\n\
      \            [complex(i, q) for i in niveaux for q in niveaux],\n          \
      \  dtype=np.complex64\n        )\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n        d = np.abs(x[:, None] - self.symboles[None,\
      \ :])\n        output_items[0][:] = self.symboles[np.argmin(d, axis=1)]\n  \
      \      return len(output_items[0])"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('16 QAM symbole plus proche', 'blk', [], [('0', 'complex', 1)], [('0',
      'complex', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2256, 376.0]
    rotation: 0
    state: enabled
