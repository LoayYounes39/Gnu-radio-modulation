- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Mapping 8PSK',\n        \
      \    in_sig=[np.uint8],\n            out_sig=[np.complex64]\n        )\n        c = np.sqrt(0.5)\
      \   # cos(45 deg) = sin(45 deg) = 0.7071\n        # 8 points sur le cercle unite, pas de 45 deg,\
      \ code de Gray\n        self.dico = {\n            0: 1+0j,        # 000 :   0 deg\n           \
      \ 1: c+1j*c,      # 001 :  45 deg\n            3: 0+1j,        # 011 :  90 deg\n            2: -c+1j*c,\
      \     # 010 : 135 deg\n            6: -1+0j,       # 110 : 180 deg\n            7: -c-1j*c,    \
      \ # 111 : 225 deg\n            5: 0-1j,        # 101 : 270 deg\n            4: c-1j*c       # 100\
      \ : 315 deg\n        }\n\n    def work(self, input_items, output_items):\n        symboles = input_items[0]\n\
      \        out = output_items[0]\n\n        for i, s in enumerate(symboles):\n            out[i] =\
      \ self.dico[int(s)]\n\n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    _io_cache: ('Mapping 8PSK', 'blk', [], [('0', 'byte', 1)], [('0', 'complex', 1)], '', [])
  states:
    _io_cache: ('Mapping 16QAM', 'blk', [], [('0', 'byte', 1)], [('0', 'complex', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 1088.0
    rotation: 0
    state: enabled
- name: epy_block_1_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='8PSK symbole plus proche',\n\
      \            in_sig=[np.complex64],\n            out_sig=[np.complex64]\n        )\n        c =\
      \ np.sqrt(0.5)\n        # memes 8 points que le mapping (angle = k x 45 deg)\n        self.symboles\
      \ = np.array([1+0j, c+1j*c, 0+1j, -c+1j*c,\n                                  -1+0j, -c-1j*c, 0-1j,\
      \ c-1j*c],\n                                 dtype=np.complex64)\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]\n        # decision a distance euclidienne minimale\n\
      \        d = np.abs(x[:, None] - self.symboles[None, :])\n        output_items[0][:] = self.symboles[np.argmin(d,\
      \ axis=1)]\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    _io_cache: ('8PSK symbole plus proche', 'blk', [], [('0', 'complex', 1)], [('0', 'complex', 1)], '',
      [])
  states:
    _io_cache: ('16 QAM symbole plus proche', 'blk', [], [('0', 'complex', 1)], [('0', 'complex', 1)],
      '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2256
    - 376.0
    rotation: 0
    state: enabled
