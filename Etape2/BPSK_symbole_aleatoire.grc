- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\nimport numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Mapping BPSK',\n            in_sig=[np.uint8],\n        \
      \    out_sig=[np.float32]\n        )\n\n        # Mapping des bits vers les\
      \ symboles BPSK\n        self.dico = {\n            0: 1,\n            1: -1\n\
      \        }\n\n    def work(self, input_items, output_items):\n        bits =\
      \ input_items[0]\n        out = output_items[0]\n\n        for i, bit in enumerate(bits):\n\
      \            out[i] = self.dico[int(bit)]\n\n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Mapping BPSK', 'blk', [], [('0', 'byte', 1)], [('0', 'float', 1)],
      '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 720.0]
    rotation: 0
    state: enabled
- name: note_0
  id: note
  parameters:
